{
  "name": "payton-pizza",
  "private": true,
  "type": "module",
  "description": "Payton Pizza: an arcade pizza-delivery web game for phones and keyboards.",
  "license": "UNLICENSED",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview --port 4173 --strictPort",
