    "check": "npm run lint && npm test && npm run build && npm run test:e2e"
  },
  "dependencies": {
    "three": "^0.170.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@playwright/test": "^1.49.0",
    "eslint": "^9.0.0",
    "globals": "^15.0.0",
    "vite": "^6.0.0",
    "vitest": "^3.0.0"
  }
